PORT=5001
GROQ_API_KEY=
GROQ_API_KEY_ORGANIC=
GROQ_API_KEY_INORGANIC=
GROQ_API_KEY_COMBUSTION=
# Primary model — used for all analysis calls
GROQ_MODEL=qwen/qwen3.8-27b
# Fallback model — auto-used when primary hits a 429 rate-limit (OTPM exceeded)
# Must be a model available in your Groq org (check: GET /openai/v1/models)
GROQ_MODEL_FALLBACK=openai/gpt-oss-20b
MONGODB_URI=
